{
  "expo": {
    "name": "Planmoni",
    "slug": "planmoni",
    "version": "2.0.6",
    "orientation": "portrait",
    "icon": "./assets/images/AppIcon.png",
    "scheme": "myapp",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "notification": {
      "icon": "./assets/images/AppIcon.png",
      "color": "#1E3A8A"
    },
    "splash": {
      "image": "./assets/images/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#1E3A8A"
    },
    "android": {
      "package": "com.planmoni",
      "versionCode": 3,
      "softwareKeyboardLayoutMode": "resize",
      "useNextNotificationsApi": true,
      "permissions": [
        "android.permission.CAMERA"
      ]
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.planmoni",
      "buildNumber": "1",
      "infoPlist": {
        "UIBackgroundModes": [
          "remote-notification",
          "processing"
        ],
        "ITSAppUsesNonExemptEncryption": false,
        "NSLocationWhenInUseUsageDescription": "This app uses location services to provide a better experience.",
        "NSLocationAlwaysUsageDescription": "This app uses location services to provide a better experience.",
        "NSLocationUsageDescription": "This app uses location services to provide a better experience.",
        "NSPhotoLibraryUsageDescription": "This app uses the photo library to provide a better experience.",
        "NSCameraUsageDescription": "This app needs access to camera for liveness verification",
        "NSMicrophoneUsageDescription": "This app uses the microphone to provide a better experience."
      },
      "entitlements": {
        "aps-environment": "development",
        "keychain-access-groups": [
          "$(AppIdentifierPrefix)app.planmoni"
        ]
      }
    },
    "web": {
      "bundler": "metro",
      "output": "server",
      "favicon": "./assets/images/AppIcon.png"
    },
    "plugins": [
      [
        "@intercom/intercom-react-native",
        {
          "appId": "tf4dp3qt",
          "androidApiKey": "android_sdk-c13200a10981c64eb6e2b4030551b67de50243bf",
          "iosApiKey": "ios_sdk-0defee459efb13cd27f68001a4f66ca6b468d9f4",
          "intercomRegion": "US"
        }
      ],
      "expo-router",
      "expo-secure-store",
      "expo-font",
      "expo-web-browser",
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 36,
            "targetSdkVersion": 36,
            "minSdkVersion": 24,
            "buildToolsVersion": "36.0.0"
          },
          "ios": {
            "deploymentTarget": "15.1"
          }
        }
      ],
      [
        "@intercom/intercom-react-native",
        {
          "appId": "tf4dp3qt",
          "androidApiKey": "android_sdk-c13200a10981c64eb6e2b4030551b67de50243bf",
          "iosApiKey": "ios_sdk-0defee459efb13cd27f68001a4f66ca6b468d9f4",
          "intercomRegion": "US"
        }
      ],
      "expo-navigation-bar",
      {
        "backgroundColor": "#0f172a",
        "barStyle": "light",
        "borderColor": "#1f2937",
        "visibility": "visible",
        "behavior": "inset-swipe",
        "position": "relative"
      }
    ],
    "experiments": {
      "typedRoutes": true
    },
    "updates": {
      "url": "https://u.expo.dev/05caad20-9b74-4ba8-8280-dc5939b7ca83",
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    },
    "runtimeVersion": "1.3.7",
    "extra": {
      "router": {},
      "eas": {
        "projectId": "05caad20-9b74-4ba8-8280-dc5939b7ca83"
      },
      "INTERCOM": {
        "iosApiKey": "ios_sdk-de52645ae34ab0f059890a422f90b18092032115",
        "androidApiKey": "android_sdk-c13200a10981c64eb6e2b4030551b67de50243bf",
        "appId": "tf4dp3qt"
      }
    },
    "owner": "planmoni"
  }
}
