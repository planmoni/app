{
  "expo": {
    "name": "Planmoni",
    "slug": "planmoni",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/AppIcon.png",
    "scheme": "myapp",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#1E3A8A"
    },
    "android": {
      "package": "com.planmoni"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.planmoni",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "UIBackgroundModes": [
          "remote-notification"
        ]
      }
    },
    "web": {
      "bundler": "metro",
      "output": "server",
      "favicon": "./assets/images/AppIcon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-web-browser",
      [
        "expo-build-properties",
        { "android": { "compileSdkVersion": 35, "targetSdkVersion": 35, "minSdkVersion": 23 } }
      ],
      [
        "@intercom/intercom-react-native",
        {
          "appId": "tf4dp3qt",
          "androidApiKey": "android_sdk-c13200a10981c64eb6e2b4030551b67de50243bf",
          "iosApiKey": "ios_sdk-de52645ae34ab0f059890a422f90b18092032115",
          "intercomRegion": "US"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "d01818de-e1dd-41c4-8b3d-5d1cfbf2696b"
      },
      "INTERCOM": {
        "iosApiKey": "ios_sdk-de52645ae34ab0f059890a422f90b18092032115",
        "androidApiKey": "android_sdk-c13200a10981c64eb6e2b4030551b67de50243bf",
        "appId": "tf4dp3qt"
      }
    },
    "owner": "planmoni"
  }
}