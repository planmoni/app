{
  "expo": {
    "name": "Planmoni",
    "slug": "planmoni",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/AppIcon.png",
    "scheme": "myapp",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#1E3A8A"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.planmoni",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "web": {
      "bundler": "metro",
      "output": "server",
      "favicon": "./assets/images/AppIcon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-web-browser",
      [
        "expo-build-properties",
        { "android": { "compileSdkVersion": 35, "targetSdkVersion": 35, "minSdkVersion": 23 } }
      ],
      [
        "@intercom/intercom-react-native",
        {
          "iosApiKey": "${INTERCOM_IOS_API_KEY}",
          "androidApiKey": "${INTERCOM_ANDROID_API_KEY}",
          "appId": "${INTERCOM_APP_ID}",
          "isPushNotificationsEnabledAndroid": true,
          "isPushNotificationsEnabledIOS": true
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "d01818de-e1dd-41c4-8b3d-5d1cfbf2696b"
      },
      "INTERCOM": {
        "iosApiKey": "${INTERCOM_IOS_API_KEY}",
        "androidApiKey": "${INTERCOM_ANDROID_API_KEY}",
        "appId": "${INTERCOM_APP_ID}"
      }
    },
    "owner": "planmoni"
  }
}