{
  "expo": {
    "name": "Planmoni",
    "slug": "planmoni",
    "version": "1.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/AppIcon.png",
    "scheme": "myapp",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "notification": {
      "icon": "./assets/images/AppIcon.png",
      "color": "#1E3A8A"
    },
    "splash": {
      "image": "./assets/images/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#1E3A8A"
    },
    "android": {
      "package": "com.planmoni",
      "versionCode": 10,
      "softwareKeyboardLayoutMode": "resize",
      "useNextNotificationsApi": true,
     "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_EXTERNAL_STORAGE"
      ]
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.planmoni",
      "buildNumber": "10",
      "infoPlist": {
        "UIBackgroundModes": ["remote-notification"],
        "ITSAppUsesNonExemptEncryption": false,
        "NSLocationWhenInUseUsageDescription": "This app uses location services to provide a better experience.",
        "NSLocationAlwaysUsageDescription": "This app uses location services to provide a better experience.",
        "NSLocationUsageDescription": "This app uses location services to provide a better experience.",
        "NSPhotoLibraryUsageDescription": "This app uses the photo library to provide a better experience.",
        "NSCameraUsageDescription": "This app needs access to camera for liveness verification",
        "NSMicrophoneUsageDescription": "This app uses the microphone to provide a better experience."
      },
      "entitlements": {
        "aps-environment": "development",
        "keychain-access-groups": ["$(AppIdentifierPrefix)com.planmoni"]
      }
    },
    "web": {
      "bundler": "metro",
      "output": "server",
      "favicon": "./assets/images/AppIcon.png"
    },
    "plugins": [
      [
        "react-native-vision-camera",
        {
          "cameraPermissionText": "$(PRODUCT_NAME) needs access to your Camera to perform liveness verification.",
          "enableMicrophonePermission": false,
          "enableCodeScanner": false
        }
      ],
      [
        "@intercom/intercom-react-native",
        {
          "appId": "tf4dp3qt",
          "androidApiKey": "android_sdk-c13200a10981c64eb6e2b4030551b67de50243bf",
          "iosApiKey": "ios_sdk-0defee459efb13cd27f68001a4f66ca6b468d9f4",
          "intercomRegion": "US"
        }
      ],
      "expo-router",
      "expo-secure-store",
      "expo-font",
      "expo-web-browser",
      [
        "expo-build-properties",
        { 
          "android": { 
            "compileSdkVersion": 35, 
            "targetSdkVersion": 35, 
            "minSdkVersion": 26,
            "buildToolsVersion": "35.0.0"
          },
          "ios": {
            "deploymentTarget": "16.0"
          }
        }
      ],
      [
        "@intercom/intercom-react-native",
        {
          "appId": "tf4dp3qt",
          "androidApiKey": "android_sdk-c13200a10981c64eb6e2b4030551b67de50243bf",
          "iosApiKey": "ios_sdk-0defee459efb13cd27f68001a4f66ca6b468d9f4",
          "intercomRegion": "US"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "d01818de-e1dd-41c4-8b3d-5d1cfbf2696b"
      },
      "INTERCOM": {
        "iosApiKey": "ios_sdk-de52645ae34ab0f059890a422f90b18092032115",
        "androidApiKey": "android_sdk-c13200a10981c64eb6e2b4030551b67de50243bf",
        "appId": "tf4dp3qt"
      }
    },
    "owner": "planmoni"
  }
}