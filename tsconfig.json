{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "paths": {
      "@/*": [
        "./*"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx"
  ]
  ,
  "exclude": [
    "supabase/functions/**",
    "node_modules",
    "dist",
    "build",
    "**/*.d.ts"
  ]
}
