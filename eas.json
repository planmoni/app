{
  "cli": {
    "version": ">= 13.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "base": {
      "env": {
        "SENTRY_DISABLE_AUTO_UPLOAD": "true",
        "EXPO_PUBLIC_NATIVE_MODULES_SYNCED": "true",
        "EXPO_PUBLIC_USE_REANIMATED": "true",
        "EXPO_PUBLIC_USE_GESTURE_HANDLER": "true"
      }
    },
    "development": {
      "extends": "base",
      "developmentClient": true,
      "channel": "development",
      "distribution": "internal",
      "android": {
        "gradleCommand": ":app:assembleDebug",
        "autoIncrement": true
      },
      "ios": {
        "buildConfiguration": "Debug",
        "autoIncrement": true
      }
    },
    "preview": {
      "extends": "base",
      "channel": "preview",
      "distribution": "internal",
      "android": {
        "buildType": "apk",
        "autoIncrement": true
      },
      "ios": {
        "simulator": false,
        "autoIncrement": true
      }
    },
    "production": {
      "extends": "base",
      "channel": "production",
      "android": {
        "autoIncrement": true,
        "buildType": "app-bundle",
        "image": "latest"
      },
      "ios": {
        "autoIncrement": true,
        "image": "latest"
      }
    }
  },
  "submit": {
    "production": {
      "android": {
        "serviceAccountKeyPath": "./android-service-account.json"
      },
      "ios": {}
    }
  }
}
